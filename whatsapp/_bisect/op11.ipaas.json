{
  "openapi": "3.0.3",
  "info": {
    "title": "bisect op11 GET /{Message-History-ID}/events",
    "version": "v23.0",
    "description": "API for retrieving connected client businesses associated with a Meta application.\n\n\nThis endpoint allows applications to retrieve information about businesses that have\nestablished client connections through the application. This is essential for managing\nbusiness relationships and understanding client business configurations.\n",
    "contact": {
      "name": "Meta Business Platform Team",
      "url": "https://developers.facebook.com/support"
    },
    "license": {
      "name": "Meta Platform Terms",
      "url": "https://developers.facebook.com/terms"
    },
    "termsOfService": "https://developers.facebook.com/terms"
  },
  "servers": [
    {
      "url": "https://graph.facebook.com/v23.0",
      "description": "WhatsApp Business Cloud API (v23.0)"
    }
  ],
  "tags": [
    {
      "name": "mensagens",
      "description": "Envio de mensagens, mídia, chamadas e histórico de conversas."
    }
  ],
  "paths": {
    "/{Message-History-ID}/events": {
      "get": {
        "summary": "Get WhatsApp Message History Events",
        "description": "Retrieve paginated message delivery status events for a specific message history entry,\nincluding delivery status occurrences, timestamps, and application information.\n\n\n**Use Cases:**\n- Track detailed message delivery status events and transitions\n- Monitor delivery status occurrence timestamps\n- Retrieve application information for delivery events\n- Debug message delivery issues and status changes\n\n\n**Rate Limiting:**\nStandard Graph API rate limits apply. Use appropriate retry logic with exponential backoff.\n\n\n**Caching:**\nMessage history events can be cached for short periods, but delivery status events\nmay change frequently. Implement appropriate cache invalidation strategies.\n\n\n**Pagination:**\nThis endpoint supports cursor-based pagination. Use the `after` and `before` cursors\nfrom the response to navigate through results.\n",
        "operationId": "getMessageHistoryEvents",
        "tags": [
          "mensagens"
        ],
        "parameters": [
          {
            "name": "Message-History-ID",
            "in": "path",
            "required": true,
            "description": "Your WhatsApp Business Message History ID. This ID is provided when you retrieve\nmessage history and can be found through message history APIs.\n",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "example": "1234567890123456"
          },
          {
            "name": "status_filter",
            "in": "query",
            "required": false,
            "description": "Filter results by specific delivery status. When provided,\nonly events with this delivery status will be returned.\n",
            "schema": {
              "type": "string",
              "description": "Message delivery status",
              "enum": [
                "SENT",
                "DELIVERED",
                "READ",
                "FAILED",
                "DELETED"
              ],
              "example": "DELIVERED"
            },
            "example": "DELIVERED"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of fields to include in the response. If not specified,\ndefault fields will be returned (cursor, node{id,delivery_status,occurrence_timestamp}).\nAvailable fields: cursor, node{id,delivery_status,error_description,occurrence_timestamp,status_timestamp,application}\n",
            "schema": {
              "type": "string"
            },
            "example": "cursor,node{id,delivery_status,occurrence_timestamp,application}"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of message history events to return per page.\nDefault is 25, maximum is 100.\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "example": 25
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Cursor for pagination. Use this to get the next page of results.\nThis value comes from the `paging.cursors.after` field in previous responses.\n",
            "schema": {
              "type": "string"
            },
            "example": "MTAxNTExOTQ1MjAwNzI5NDE="
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor for pagination. Use this to get the previous page of results.\nThis value comes from the `paging.cursors.before` field in previous responses.\n",
            "schema": {
              "type": "string"
            },
            "example": "MAZDZD"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved WhatsApp message history events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Paginated response containing message history events",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Array of message history event edges",
                      "items": {
                        "type": "object",
                        "description": "Edge containing message delivery status occurrence with pagination cursor",
                        "required": [
                          "node"
                        ],
                        "properties": {
                          "cursor": {
                            "type": "string",
                            "description": "Pagination cursor for this edge",
                            "example": "MTAxNTExOTQ1MjAwNzI5NDE="
                          },
                          "node": {
                            "type": "object",
                            "description": "Message delivery status occurrence with detailed event information",
                            "required": [
                              "id",
                              "delivery_status",
                              "occurrence_timestamp"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Unique identifier for the message delivery status occurrence",
                                "example": "2345678901234567"
                              },
                              "delivery_status": {
                                "type": "string",
                                "description": "Message delivery status",
                                "enum": [
                                  "SENT",
                                  "DELIVERED",
                                  "READ",
                                  "FAILED",
                                  "DELETED"
                                ],
                                "example": "DELIVERED"
                              },
                              "error_description": {
                                "type": "string",
                                "description": "Error description if the delivery encountered an error",
                                "example": "Message delivery failed due to invalid phone number"
                              },
                              "occurrence_timestamp": {
                                "type": "integer",
                                "format": "int64",
                                "description": "Unix timestamp when the delivery status occurrence happened",
                                "example": 1640995200
                              },
                              "status_timestamp": {
                                "type": "integer",
                                "format": "int64",
                                "description": "Unix timestamp when the status was recorded",
                                "example": 1640995205
                              },
                              "application": {
                                "type": "object",
                                "description": "Meta application that owns the Multi-Partner Solution",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "description": "Unique identifier for the Meta application",
                                    "example": "9876543210987654"
                                  },
                                  "name": {
                                    "type": "string",
                                    "description": "Name of the Meta application",
                                    "example": "Solution Partner App"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "paging": {
                      "type": "object",
                      "description": "Pagination information for navigating through results",
                      "properties": {
                        "cursors": {
                          "type": "object",
                          "description": "Pagination cursors for navigation",
                          "properties": {
                            "before": {
                              "type": "string",
                              "description": "Cursor for the previous page of results",
                              "example": "MAZDZD"
                            },
                            "after": {
                              "type": "string",
                              "description": "Cursor for the next page of results",
                              "example": "MTAxNTExOTQ1MjAwNzI5NDE="
                            }
                          }
                        },
                        "previous": {
                          "type": "string",
                          "format": "uri",
                          "description": "URL for the previous page of results",
                          "example": "https://graph.facebook.com/v23.0/1234567890123456/message_history?before=MAZDZD"
                        },
                        "next": {
                          "type": "string",
                          "format": "uri",
                          "description": "URL for the next page of results",
                          "example": "https://graph.facebook.com/v23.0/1234567890123456/message_history?after=MTAxNTExOTQ1MjAwNzI5NDE="
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "message_history_events": {
                    "summary": "Message history events with delivery status occurrences",
                    "value": {
                      "data": [
                        {
                          "cursor": "MTAxNTExOTQ1MjAwNzI5NDE=",
                          "node": {
                            "id": "2345678901234567",
                            "delivery_status": "SENT",
                            "occurrence_timestamp": 1640995200,
