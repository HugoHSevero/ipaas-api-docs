{
  "openapi": "3.0.3",
  "info": {
    "title": "Bisect op6",
    "description": "Admin API do Cloudinary: gerenciamento dos assets (recursos) armazenados no product environment — listagem, detalhes, busca, atualização, exclusão em lote e restauração. API rate-limited, autenticada por HTTP Basic Auth (api_key:api_secret). Base URL: https://api.cloudinary.com/v1_1/{cloud_name}.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cloudinary.com/v1_1",
      "description": "Produção (US). Para EU/AP use api-eu/api-ap."
    }
  ],
  "tags": [
    {
      "name": "Recursos"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth com api_key como usuário e api_secret como senha."
      }
    }
  },
  "paths": {
    "/{cloud_name}/resources/restore": {
      "post": {
        "tags": [
          "Recursos"
        ],
        "summary": "Restaurar assets do backup",
        "description": "Restaura um ou mais assets a partir do backup, identificados pelo public_id. Requer backup habilitado no product environment.",
        "operationId": "restore-resources",
        "parameters": [
          {
            "name": "cloud_name",
            "in": "path",
            "required": true,
            "description": "Nome do product environment (cloud name).",
            "schema": {
              "type": "string",
              "example": "demo"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "public_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "public_ids dos assets a restaurar."
                  },
                  "versions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Versões específicas a restaurar (opcional)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assets restaurados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asset_id": {
                      "type": "string"
                    },
                    "public_id": {
                      "type": "string"
                    },
                    "format": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "resource_type": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "folder": {
                      "type": "string"
                    },
                    "asset_folder": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "secure_url": {
                      "type": "string"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "context": {
                      "type": "object"
                    },
                    "next_cursor": {
                      "type": "string"
                    },
                    "derived": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "transformation": {
                            "type": "string"
                          },
                          "format": {
                            "type": "string"
                          },
                          "bytes": {
                            "type": "integer"
                          },
                          "url": {
                            "type": "string"
                          },
                          "secure_url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
