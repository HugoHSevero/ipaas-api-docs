{
  "openapi": "3.0.3",
  "info": {
    "title": "bisect op07 GET /{Phone-Number-ID}/message_history",
    "version": "v23.0",
    "description": "API for retrieving connected client businesses associated with a Meta application.\n\n\nThis endpoint allows applications to retrieve information about businesses that have\nestablished client connections through the application. This is essential for managing\nbusiness relationships and understanding client business configurations.\n",
    "contact": {
      "name": "Meta Business Platform Team",
      "url": "https://developers.facebook.com/support"
    },
    "license": {
      "name": "Meta Platform Terms",
      "url": "https://developers.facebook.com/terms"
    },
    "termsOfService": "https://developers.facebook.com/terms"
  },
  "servers": [
    {
      "url": "https://graph.facebook.com/v23.0",
      "description": "WhatsApp Business Cloud API (v23.0)"
    }
  ],
  "tags": [
    {
      "name": "mensagens",
      "description": "Envio de mensagens, mídia, chamadas e histórico de conversas."
    }
  ],
  "paths": {
    "/{Phone-Number-ID}/message_history": {
      "get": {
        "summary": "Get WhatsApp Business Account Message History",
        "description": "Retrieve paginated message history for a WhatsApp Business Account phone number,\nincluding delivery status events, timestamps, and webhook update information.\n\n\n**Use Cases:**\n- Track message delivery status and events\n- Monitor webhook delivery and update states\n- Retrieve historical message delivery information\n- Debug message delivery issues and webhook failures\n\n\n**Rate Limiting:**\nStandard Graph API rate limits apply. Use appropriate retry logic with exponential backoff.\n\n\n**Caching:**\nMessage history data can be cached for moderate periods, but delivery status events\nmay change frequently. Implement appropriate cache invalidation strategies.\n\n\n**Pagination:**\nThis endpoint supports cursor-based pagination. Use the `after` and `before` cursors\nfrom the response to navigate through results.\n",
        "operationId": "getMessageHistory",
        "tags": [
          "mensagens"
        ],
        "parameters": [
          {
            "name": "Phone-Number-ID",
            "in": "path",
            "required": true,
            "description": "Your WhatsApp Business Account phone number ID. This ID is provided when you register\nthe phone number and can be found in your WhatsApp Business Manager or through phone number APIs.\n",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "example": "1234567890123456"
          },
          {
            "name": "message_id",
            "in": "query",
            "required": false,
            "description": "Filter results by specific WhatsApp message ID (WAMID). When provided,\nonly message history for this specific message will be returned.\n",
            "schema": {
              "type": "string"
            },
            "example": "wamid.HBgLMTY0NzM3Nzc3NzUVAgARGBI5QTNEQTA2RjdGMEY4RTRGAA=="
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of fields to include in the response. If not specified,\ndefault fields will be returned (id, message_id).\nAvailable fields: id, message_id, events{delivery_status,webhook_update_state,timestamp,application,webhook_uri,error_description}\n",
            "schema": {
              "type": "string"
            },
            "example": "id,message_id,events{delivery_status,timestamp,webhook_update_state}"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of message history entries to return per page.\nDefault is 25, maximum is 100.\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "example": 25
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Cursor for pagination. Use this to get the next page of results.\nThis value comes from the `paging.cursors.after` field in previous responses.\n",
            "schema": {
              "type": "string"
            },
            "example": "MTAxNTExOTQ1MjAwNzI5NDE="
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor for pagination. Use this to get the previous page of results.\nThis value comes from the `paging.cursors.before` field in previous responses.\n",
            "schema": {
              "type": "string"
            },
            "example": "MAZDZD"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved WhatsApp Business Account message history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Paginated response containing message history entries",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Array of message history entries",
                      "items": {
                        "type": "object",
                        "description": "WhatsApp message history entry with delivery status information",
                        "required": [
                          "id",
                          "message_id"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique identifier for the message history entry",
                            "example": "1234567890123456"
                          },
                          "message_id": {
                            "type": "string",
                            "description": "WhatsApp message ID (WAMID) for the message",
                            "example": "wamid.HBgLMTY0NzM3Nzc3NzUVAgARGBI5QTNEQTA2RjdGMEY4RTRGAA=="
                          },
                          "events": {
                            "type": "object",
                            "description": "Message delivery status events and occurrences",
                            "properties": {
                              "data": {
                                "type": "array",
                                "description": "Array of delivery status events",
                                "items": {
                                  "type": "object",
                                  "description": "Message delivery status event occurrence",
                                  "required": [
                                    "id",
                                    "delivery_status",
                                    "timestamp"
                                  ],
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "description": "Unique identifier for the delivery status event",
                                      "example": "2345678901234567"
                                    },
                                    "delivery_status": {
                                      "type": "string",
                                      "description": "Message delivery status",
                                      "enum": [
                                        "SENT",
                                        "DELIVERED",
                                        "READ",
                                        "FAILED",
                                        "DELETED"
                                      ],
                                      "example": "DELIVERED"
                                    },
                                    "webhook_update_state": {
                                      "type": "string",
                                      "description": "State of webhook update delivery",
                                      "enum": [
                                        "PENDING",
                                        "DELIVERED",
                                        "FAILED",
                                        "RETRYING"
                                      ],
                                      "example": "DELIVERED"
                                    },
                                    "timestamp": {
                                      "type": "integer",
                                      "format": "int64",
                                      "description": "Unix timestamp when the delivery status event occurred",
                                      "example": 1640995200
                                    },
                                    "application": {
                                      "type": "object",
                                      "description": "Application information for the event",
                                      "properties": {
                                        "id": {
                                          "type": "string",
                                          "description": "Application ID that processed the event",
                                          "example": "9876543210987654"
                                        }
                                      }
                                    },
                                    "webhook_uri": {
                                      "type": "string",
                                      "format": "uri",
                                      "description": "Webhook URI where the event was delivered",
                                      "example": "https://example.com/webhook"
                                    },
                                    "error_description": {
                                      "type": "string",
                                      "description": "Error description if the delivery failed",
                                      "example": "Webhook endpoint returned HTTP 500"
                                    }
                                  }
                                }
                              },
                              "paging": {
                                "type": "object",
                                "description": "Pagination information for navigating through results",
                                "properties": {
                                  "cursors": {
                                    "type": "object",
                                    "description": "Pagination cursors for navigation",
                                    "properties": {
                                      "before": {
                                        "type": "string",
                                        "description": "Cursor for the previous page of results",
                                        "example": "MAZDZD"
                                      },
                                      "after": {
                                        "type": "string",
                                        "description": "Cursor for the next page of results",
                                        "example": "MTAxNTExOTQ1MjAwNzI5NDE="
                                      }
                                    }
                                  },
