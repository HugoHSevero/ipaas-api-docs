          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Corpo da requisição para criação de pacote (múltiplos envios) de um pedido",
                "required": [
                  "packages"
                ],
                "properties": {
                  "packageReason": {
                    "type": "object",
                    "description": "Motivo do pacote, utilizado pelo mecanismo de integração com marketplaces remotos",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Código do motivo"
                      },
                      "description": {
                        "type": "string",
                        "description": "Descrição do motivo"
                      }
                    },
                    "example": {
                      "id": "string",
                      "description": "string"
                    }
                  },
                  "packages": {
                    "type": "array",
                    "description": "Pacotes a serem criados para o pedido",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "description": "Um pacote a ser criado para o pedido",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "dimensions": {
                          "type": "object",
                          "description": "Dimensões do pacote, em centímetros. Cada campo é individualmente opcional.",
