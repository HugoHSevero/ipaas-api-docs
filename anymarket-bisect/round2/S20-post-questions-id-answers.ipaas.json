  "paths": {
    "/questions/{id}/answers": {
      "parameters": [
        {
          "schema": {
            "type": "integer"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ID da pergunta"
        }
      ],
      "post": {
        "summary": "Insere uma nova resposta na pergunta",
        "operationId": "post-questions-id-answers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "ID da resposta gerado pelo ANYMARKET",
                      "format": "int64",
                      "minimum": 0
                    },
                    "answer": {
                      "type": "string",
                      "description": "Resposta",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "answer"
                  ]
                }
              }
            }
          }
        },
        "description": "# Insere uma nova resposta na pergunta\nInsere uma nova resposta na pergunta. Atualmente apenas para o MARKETPLACE MERCADO LIVRE.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "ID da resposta gerado pelo ANYMARKET",
                    "format": "int64",
                    "minimum": 0
                  },
                  "answer": {
                    "type": "string",
                    "description": "Resposta",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "answer"
                ]
              }
            }
          }
        },
        "tags": [
          "Perguntas"
        ]
      }
    }
