    "/{cloud_name}/{resource_type}/destroy": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Excluir asset por public_id",
        "description": "Exclui permanentemente um único asset do product environment, identificado por public_id e resource_type.",
        "operationId": "destroy-asset",
        "parameters": [
          {
            "name": "cloud_name",
            "in": "path",
            "required": true,
            "description": "Nome do product environment (cloud name).",
            "schema": {
              "type": "string",
              "example": "demo"
            }
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "description": "Tipo de asset. Valores: image, raw, video.",
            "schema": {
              "type": "string",
              "example": "image"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "public_id": {
                    "type": "string",
                    "description": "public_id do asset a excluir."
                  },
                  "type": {
                    "type": "string",
                    "description": "Tipo de entrega. Default: upload."
                  },
                  "invalidate": {
                    "type": "boolean",
                    "description": "Invalidar cópias em cache no CDN. Default: false."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da exclusão",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "description": "Resultado da operação, ex.: ok ou not found."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "Descrição do erro."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{cloud_name}/{resource_type}/tags": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Gerenciar tags de assets",
        "description": "Adiciona, remove ou substitui tags em um ou mais assets. O comando é definido em `command` (add, remove, replace, remove_all).",
        "operationId": "manage-tags",
        "parameters": [
          {
            "name": "cloud_name",
            "in": "path",
            "required": true,
            "description": "Nome do product environment (cloud name).",
            "schema": {
              "type": "string",
              "example": "demo"
            }
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "description": "Tipo de asset. Valores: image, raw, video.",
            "schema": {
              "type": "string",
              "example": "image"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "description": "Operação: add, remove, replace, remove_all."
                  },
                  "tag": {
                    "type": "string",
                    "description": "Tag (ou tags separadas por vírgula) a aplicar."
                  },
                  "public_ids": {
                    "type": "string",
                    "description": "public_ids dos assets afetados, separados por vírgula."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tags atualizadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "public_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "public_ids afetados."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "Descrição do erro."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
