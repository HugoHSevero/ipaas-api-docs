{
  "openapi": "3.0.3",
  "info": {
    "title": "Bisect op3-noboolq",
    "description": "Admin API do Cloudinary: gerenciamento dos assets (recursos) armazenados no product environment — listagem, detalhes, busca, atualização, exclusão em lote e restauração. API rate-limited, autenticada por HTTP Basic Auth (api_key:api_secret). Base URL: https://api.cloudinary.com/v1_1/{cloud_name}.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cloudinary.com/v1_1",
      "description": "Produção (US). Para EU/AP use api-eu/api-ap."
    }
  ],
  "tags": [
    {
      "name": "Recursos"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth com api_key como usuário e api_secret como senha."
      }
    }
  },
  "paths": {
    "/{cloud_name}/resources/{resource_type}/{type}/{public_id}": {
      "delete": {
        "tags": [
          "Recursos"
        ],
        "summary": "Excluir assets em lote",
        "description": "Exclui assets do product environment por tipo de recurso e entrega. Pode filtrar por public_ids, prefixo ou todos. Opera em blocos de até 1000.",
        "operationId": "delete-resources",
        "parameters": [
          {
            "name": "cloud_name",
            "in": "path",
            "required": true,
            "description": "Nome do product environment (cloud name).",
            "schema": {
              "type": "string",
              "example": "demo"
            }
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "description": "Tipo de asset: image, raw, video.",
            "schema": {
              "type": "string",
              "example": "image"
            }
          },
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Tipo de entrega: upload, private, authenticated.",
            "schema": {
              "type": "string",
              "example": "upload"
            }
          },
          {
            "name": "public_ids",
            "in": "query",
            "description": "Lista de public_ids a excluir (separados por vírgula; até 100).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "description": "Exclui todos os assets cujo public_id começa com o prefixo.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "next_cursor",
            "in": "query",
            "description": "Cursor para continuar a exclusão em blocos.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado da exclusão",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "object",
                      "description": "Mapa de public_id para resultado (deleted, not_found)."
                    },
                    "deleted_counts": {
                      "type": "object"
                    },
                    "partial": {
                      "type": "boolean"
                    },
                    "next_cursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
