                    },
                    "public_id": {
                      "type": "string",
                      "description": "Identificador público do asset."
                    },
                    "version": {
                      "type": "integer",
                      "description": "Versão do asset."
                    },
                    "version_id": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "format": {
                      "type": "string",
                      "description": "Formato do arquivo (jpg, png, mp4...)."
                    },
                    "resource_type": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Data de criação em ISO 8601."
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "bytes": {
                      "type": "integer",
                      "description": "Tamanho em bytes."
                    },
                    "type": {
                      "type": "string"
                    },
                    "etag": {
                      "type": "string"
                    },
                    "placeholder": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL de entrega HTTP do asset."
                    },
                    "secure_url": {
                      "type": "string",
                      "description": "URL de entrega HTTPS do asset."
                    },
                    "folder": {
                      "type": "string"
                    },
                    "original_filename": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
