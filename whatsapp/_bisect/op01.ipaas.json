                        }
                      },
                      "required": [
                        "message",
                        "type",
                        "code"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                },
                "examples": {
                  "UnexpectedError": {
                    "summary": "Unexpected server error",
                    "value": {
                      "error": {
                        "message": "An unexpected error occurred",
                        "type": "OAuthException",
                        "code": 1
                      }
                    }
                  }
