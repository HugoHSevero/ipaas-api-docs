                                "type": "string",
                                "value": "string"
                              }
                            }
                          ],
                          "metadata": [
                            {
                              "key": "string",
                              "value": "string"
                            }
                          ]
                        }
                      ],
                      "links": [
                        {
                          "rel": "string",
                          "href": "string"
                        }
                      ],
                      "page": {
                        "size": 0,
                        "totalElements": 0,
                        "totalPages": 0,
                        "number": 0
                      }
                    }
                  },
                  "stoplight-Example 1": {
                    "value": {
                      "content": [
                        {
                          "id": "47.",
