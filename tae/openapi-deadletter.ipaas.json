                    "format": "date-time",
                    "nullable": true
                  },
                  "finalDate": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "status": {
                    "enum": [
                      0,
                      1,
                      2,
                      3
