                  "status": {
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ],
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "additionalProperties": false
              }
            },
            "application/*+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventType": {
                    "type": "string",
                    "nullable": true
                  },
                  "initialDate": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "finalDate": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "status": {
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ],
