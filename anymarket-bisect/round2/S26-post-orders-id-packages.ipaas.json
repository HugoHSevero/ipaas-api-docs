                              "description": "Largura do pacote, em centímetros",
                              "minimum": 0
                            },
                            "height": {
                              "type": "number",
                              "description": "Altura do pacote, em centímetros",
                              "minimum": 0
                            },
                            "weight": {
                              "type": "number",
                              "description": "Peso do pacote",
                              "minimum": 0
