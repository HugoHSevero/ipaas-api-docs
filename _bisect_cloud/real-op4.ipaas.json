{
  "openapi": "3.0.3",
  "info": {
    "title": "Bisect op4",
    "description": "Admin API do Cloudinary: gerenciamento dos assets (recursos) armazenados no product environment — listagem, detalhes, busca, atualização, exclusão em lote e restauração. API rate-limited, autenticada por HTTP Basic Auth (api_key:api_secret). Base URL: https://api.cloudinary.com/v1_1/{cloud_name}.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cloudinary.com/v1_1",
      "description": "Produção (US). Para EU/AP use api-eu/api-ap."
    }
  ],
  "tags": [
    {
      "name": "Recursos"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth com api_key como usuário e api_secret como senha."
      }
    }
  },
  "paths": {
    "/{cloud_name}/resources/{resource_type}/tags/{tag}": {
      "get": {
        "tags": [
          "Recursos"
        ],
        "summary": "Listar assets por tag",
        "description": "Lista os assets que possuem a tag especificada.",
        "operationId": "list-resources-by-tag",
        "parameters": [
          {
            "name": "cloud_name",
            "in": "path",
            "required": true,
            "description": "Nome do product environment (cloud name).",
            "schema": {
              "type": "string",
              "example": "demo"
            }
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "description": "Tipo de asset: image, raw, video.",
            "schema": {
              "type": "string",
              "example": "image"
            }
          },
          {
            "name": "tag",
            "in": "path",
            "required": true,
            "description": "Nome da tag.",
            "schema": {
              "type": "string",
              "example": "logo"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "description": "Máximo de resultados (até 500). Default: 10.",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "name": "next_cursor",
            "in": "query",
            "description": "Cursor para a próxima página.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de assets com a tag",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "asset_id": {
                            "type": "string"
                          },
                          "public_id": {
                            "type": "string"
                          },
                          "format": {
                            "type": "string"
                          },
                          "version": {
                            "type": "integer"
                          },
                          "resource_type": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "bytes": {
                            "type": "integer"
                          },
                          "width": {
                            "type": "integer"
                          },
                          "height": {
                            "type": "integer"
                          },
                          "folder": {
                            "type": "string"
                          },
                          "asset_folder": {
                            "type": "string"
                          },
                          "display_name": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "secure_url": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "context": {
                            "type": "object"
                          },
                          "next_cursor": {
                            "type": "string"
                          },
                          "derived": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "transformation": {
                                  "type": "string"
                                },
                                "format": {
                                  "type": "string"
                                },
                                "bytes": {
                                  "type": "integer"
                                },
                                "url": {
                                  "type": "string"
                                },
                                "secure_url": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    },
                    "rate_limit_allowed": {
                      "type": "integer"
                    },
                    "rate_limit_remaining": {
                      "type": "integer"
                    },
                    "rate_limit_reset_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
