  "paths": {
    "/orders/feeds": {
      "parameters": [],
      "get": {
        "summary": "/orders/feeds",
        "tags": [
          "Feed pedido"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "description": "",
                    "type": "object",
                    "title": "OrderFeed",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "ID do pedido gerado pelo ANYMARKET",
                        "format": "int64",
                        "minimum": 0
                      },
                      "token": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Token do feed",
                        "format": "uuid"
                      }
                    },
                    "x-tags": [
                      "Feed"
                    ]
                  }
                }
              }
            }
          }
        },
        "operationId": "get-orders-feeds",
        "description": "# Consulta todos os pedidos alterados\nQuando um pedido é criado ou alterado no ANYMARKET, o mesmo é disponibilizado para consulta través desse feed e fica disponível por 30 dias (se foi lido, 30 dias a partir da data de leitura, se não foi lido, 30 dias a partir da data de criação/edição.). \n\nO caso não informado um limit o resultado da consulta de feed retorna 100 itens disponíveis aleatóriamente\n\n<!-- theme: warning -->\n> #### Atenção!\n>\n> Só serão retornados os status configurados pelo seller no painel do ANYMARKET.\n\nApós leitura dos itens dos FEED, é necessário realizar um PUT para confirmar a leitura.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 5,
              "default": 5,
              "example": 5,
              "maximum": 100
            },
            "description": "Número máximo de elementos"
          }
        ]
      }
    }
  },
  "security": [
    {
      "gumgaToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "gumgaToken": {
        "name": "gumgaToken",
        "type": "apiKey",
        "in": "header",
        "description": "Token de segurança fornecido pela Anymarket"
      }
    }
