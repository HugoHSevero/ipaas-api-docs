                    "nullable": true
                  },
                  "status": {
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ],
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "additionalProperties": false
              }
            },
            "text/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventType": {
                    "type": "string",
